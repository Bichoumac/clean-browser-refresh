{
  "manifest_version": 3,
  "name": "Clean Browser Refresh",
  "version": "1.0.0",
  "description": "Refreshes the page without its URL parameters (query string) using a configurable keyboard shortcut.",

  "permissions": ["storage", "activeTab"],

  "background": {
    "service_worker": "background.js",
    "scripts": ["common.js", "background.js"]
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["common.js", "content.js"],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_title": "Refresh without URL parameters",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },

  "commands": {
    "clean-reload": {
      "description": "Refresh without URL parameters"
    }
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "clean-browser-refresh@example.com",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
